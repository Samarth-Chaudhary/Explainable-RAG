# XAI-RAG Environment Configuration
# Mode: "demo" (uses synthetic model, data, and deterministic templates) or "configured" (production)
XAI_MODE=demo

# Model Configuration
XAI_MODEL_PATH=data/demo/model.json
XAI_MODEL_MANIFEST_PATH=data/demo/model_manifest.json
XAI_FEATURE_SCHEMA_PATH=data/demo/feature_schema.json
XAI_BACKGROUND_DATA_PATH=data/demo/explainer_background.json

# Decision Threshold & Policy Ownership
# Notice: 0.35 is an illustrative default threshold, NOT a regulatory requirement
XAI_THRESHOLD_VALUE=0.35
XAI_THRESHOLD_SOURCE="Credit Risk Committee Policy Manual v2.4 (Synthetic Fixture)"
XAI_THRESHOLD_OWNER="Head of Credit Underwriting & Risk Governance"

# SHAP Explanation Configuration
# Output space: "log_odds" (mathematically faithful margin space) or "probability"
XAI_SHAP_OUTPUT_SPACE=log_odds
XAI_SHAP_TOLERANCE=0.0001
XAI_SHAP_TOP_K=5
XAI_SHAP_CONTRIBUTION_CUTOFF=0.05

# DiCE Counterfactual Configuration
XAI_DICE_DESIRED_CLASS=0
XAI_DICE_TOTAL_CFS=3
XAI_DICE_TARGET_PROBABILITY_THRESHOLD=0.35
XAI_DICE_METHOD=genetic

# Persistence & Storage
XAI_DATABASE_URL=sqlite:///./xai_rag.db
XAI_VECTOR_INDEX_PATH=data/indexes/faiss_index.bin
XAI_BM25_INDEX_PATH=data/indexes/bm25_index.pkl
XAI_MAX_UPLOAD_SIZE_BYTES=10485760

# LLM Provider Configuration (Part 2)
XAI_LLM_PROVIDER=template_local
XAI_LLM_API_KEY=""

# Security & Auth (Part 3)
XAI_AUTH_ENABLED=false
XAI_API_SECRET_KEY=""
